# AI English Tutor - 环境变量配置示例
# 复制此文件为 .env 并填入你的 API Key

# === LLM Provider 选择 ===
# 可选: openai / anthropic / groq
LLM_PROVIDER=openai

# === OpenAI ===
OPENAI_API_KEY=sk-your-key-here
# 可选：自定义 base_url（兼容第三方 API，如 Azure/代理）
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# === Anthropic ===
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# === Groq ===
# GROQ_API_KEY=gsk-your-key-here
# GROQ_MODEL=qwen-2.5-7b

# === 应用配置 ===
# 服务器地址和端口
APP_HOST=0.0.0.0
APP_PORT=8000

# === LLM 开关（默认关闭，使用 mock 回退）===
# 开启后使用真实 LLM 调用
LLM_ENABLED=False
LLM_MODE_CONVERSATION=False
LLM_MODE_CORRECTION=False
LLM_MODE_SCORING=False

# === ASR 语音转文本（OpenAI Whisper）===
# 开启后启用语音输入功能
ASR_ENABLED=False
# 识别语言代码：en=英语，zh=中文等
ASR_LANGUAGE=en

# === TTS 文本转语音（OpenAI TTS）===
# 开启后启用语音输出功能
TTS_ENABLED=False
# 声音选择：alloy/echo/fable/onyx/nova/shimmer
TTS_VOICE=alloy
# 语速：0.25 ~ 4.0（1.0 为正常速度）
TTS_SPEED=1.0

# === Checkpoint 数据库路径（Stage 6）===
# 默认在项目根目录的 data/checkpoints.db
# CHECKPOINT_DB_PATH=/path/to/custom/checkpoints.db
